// Opsional saja. Versi Spark-only SoraChat tidak menggunakan Firebase Storage.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isChatMember(chatId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/chats/$(chatId))
        && request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.participants;
    }
    match /chat-files/{chatId}/{uid}/{fileName} {
      allow read: if isChatMember(chatId);
      allow create: if isChatMember(chatId)
        && request.auth.uid == uid
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType != null;
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == uid && isChatMember(chatId);
    }
  }
}
